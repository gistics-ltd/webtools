# ---------------------------------------------------------------------------
# Gistics Limited website environment
# Copy to .env.local and fill in real values before deploying.
# ---------------------------------------------------------------------------

# Public canonical origin, no trailing slash. [[CONFIRM: production domain]]
NEXT_PUBLIC_SITE_URL=https://www.gistics.co.ug

# SMTP (any standards-compliant mailbox/host; no SaaS form service required).
# [[CONFIRM: SMTP host/port/credentials]]
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=quotes@example.com
SMTP_PASS=replace-me

# Where quote notifications are delivered and what the From header says.
# [[CONFIRM: quote inbox and from address]]
QUOTE_TO_EMAIL=quotes@example.com
QUOTE_FROM_EMAIL=website@example.com

# Send the customer a short acknowledgement email as well. Set to false to disable.
SEND_CUSTOMER_CONFIRMATION=true
