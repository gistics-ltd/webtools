{
  "name": "gistics-website",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website and car-hire quote engine for Gistics Limited, Uganda.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "BUILD_STANDALONE=true next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:assets": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
